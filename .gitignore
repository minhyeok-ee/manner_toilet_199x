cat > .gitignore << 'EOF'
# PlatformIO
.pio/
.pioenvs/
.piolibdeps/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# Build outputs
build/
dist/
*.elf
*.bin
*.hex
*.map

# Python
__pycache__/
*.pyc
.venv/
venv/

# macOS
.DS_Store

# Logs / data
*.log
*.csv
*.wav
*.npy
recordings/
logs/
EOF